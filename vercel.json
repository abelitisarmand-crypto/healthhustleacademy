{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/products/:handle",
      "destination": "/product?handle=:handle",
      "permanent": true
    },
    {
      "source": "/cart/c/:path*",
      "destination": "https://5e2bf2-59.myshopify.com/cart/c/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
